# Production environment template - copy to `.env` on the server (never
# commit the real file; docker-compose.prod.yml reads it for both container
# env vars and, for POSTGRES_*/VITE_API_URL/*_DOMAIN, compose-file variable
# substitution). See DEPLOYMENT.md for the full first-time setup.

# --- Postgres (used directly by the db service AND must match the
# credentials embedded in DATABASE_URL below - change both together) ---
POSTGRES_USER=adventure
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=adventure

# --- API ---
DATABASE_URL=postgresql://adventure:replace-with-a-long-random-password@db:5432/adventure
PORT=3000
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.example.com/api/v1/auth/google/callback
# apps/mobile's native Google Sign-In client IDs - optional until that app exists.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
ADMIN_EMAILS=you@example.com
ALLOWED_REDIRECT_URLS=https://admin.example.com,https://app.example.com
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=5
# Same value as VITE_API_URL below - the API's own externally-reachable origin
PUBLIC_API_URL=https://api.example.com

# --- Build-time: baked into the admin/public client bundles (see
# Dockerfile.prod's VITE_API_URL build arg) - the real public API domain,
# not a docker-network address ---
VITE_API_URL=https://api.example.com

# --- Build-time: baked into the public client bundle only (see
# Dockerfile.prod's VITE_SITE_URL build arg) - canonical/OG URL base, must
# match PUBLIC_DOMAIN below ---
VITE_SITE_URL=https://app.example.com

# --- Reverse proxy (Caddy) - real domains, each must already have a DNS A
# record pointing at this server before first `docker compose up`, so
# Caddy's automatic Let's Encrypt issuance can succeed ---
PUBLIC_DOMAIN=app.example.com
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com
# Fronts the separate `crm` project's containers over the shared caddy_net
# network - not part of this repo, see Caddyfile's {$CRM_DOMAIN} block.
CRM_DOMAIN=crm.example.com
