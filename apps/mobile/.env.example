# apps/mobile runs on the host, not in docker-compose, so it needs its own
# env file (Expo loads .env from this project's own root, not the repo root).
# Copy to .env and fill in.

# The API container's LAN address, not localhost - see src/lib/api.ts.
EXPO_PUBLIC_API_URL=http://192.168.1.23:3000

# Same GCP project as the root .env's GOOGLE_CLIENT_ID/GOOGLE_IOS_CLIENT_ID -
# see src/lib/auth/google-signin.ts and MOBILE_PLAN.md Phase 0 item 2.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Optional - crash reporting is a no-op without this (see src/lib/sentry.ts).
EXPO_PUBLIC_SENTRY_DSN=

# Optional - store links shown on the min-version-gate "Update required"
# screen (see src/components/UpdateRequiredScreen.tsx). Unset until the app
# is actually published via EAS Submit; the screen falls back to text-only
# instructions until then.
EXPO_PUBLIC_IOS_STORE_URL=
EXPO_PUBLIC_ANDROID_STORE_URL=
