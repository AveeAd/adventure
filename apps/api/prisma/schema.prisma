datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MODERATOR
  USER
}

enum AuthProvider {
  GOOGLE
  APPLE
}

model User {
  id    String @id @default(uuid())
  email String @unique

  // Public-facing identity, distinct from Profile.name (a freeform display
  // name re-synced from Google on every login - see ProfilesService). Set
  // once at first login (see UsersService.generateUniqueUsername) and
  // shown everywhere a non-owner would otherwise see this account's email,
  // which must never be public. usernameIsAutoGenerated gates the single
  // self-service edit: true until the user picks their own, then locked.
  username                String  @unique
  usernameIsAutoGenerated Boolean @default(true)

  role      Role     @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile       Profile?
  refreshTokens RefreshToken[]
  authIdentities AuthIdentity[]

  revisions           PageRevision[]
  pageConfirmations   PageConfirmation[]
  uploadedMedia       Media[]
  adventurePageLikes  AdventurePageLike[]
  adventurePageVisits AdventurePageVisit[]

  createdTrails      Trail[]             @relation("TrailCreatedBy")
  lastEditedTrails   Trail[]             @relation("TrailLastEditedBy")
  trailConfirmations TrailConfirmation[]
  trailRevisions     TrailRevision[]     @relation("TrailRevisionEditor")
  createdSpots       Spot[]              @relation("SpotCreatedBy")
  lastEditedSpots    Spot[]              @relation("SpotLastEditedBy")
  spotConfirmations  SpotConfirmation[]
  spotRevisions      SpotRevision[]      @relation("SpotRevisionEditor")

  // MILESTONE_3.md §5.1: the approver whose vote resolved a pending revision
  // (blank for the pre-Phase-21 backfill, and for votes that never crossed
  // the threshold on their own - see the "resolvedById" comment on each).
  resolvedPageRevisions  PageRevision[]  @relation("PageRevisionResolvedBy")
  resolvedTrailRevisions TrailRevision[] @relation("TrailRevisionResolvedBy")
  resolvedSpotRevisions  SpotRevision[]  @relation("SpotRevisionResolvedBy")

  tripReports     TripReport[]
  tripReportKudos TripReportKudos[]
  comments        Comment[]
  activityTracks  ActivityTrack[]

  createdTripGroups    TripGroup[]
  tripGroupMemberships TripGroupMember[]

  createdClubs           Club[]
  clubMemberships        ClubMember[]
  clubMembershipsDecided ClubMember[] @relation("ClubMembershipDecidedBy")

  threads       Thread[]
  threadReplies ThreadReply[]

  guideProfile GuideProfile?

  contributionEvents ContributionEvent[]

  notifications Notification[]

  deviceTokens           DeviceToken[]
  notificationPreference NotificationPreference?

  reportsFiled    ContentReport[] @relation("ReportsFiled")
  reportsResolved ContentReport[] @relation("ReportsResolved")

  moderatorApplicationsSubmitted ModeratorApplication[] @relation("ModeratorApplicationsSubmitted")
  moderatorApplicationsReviewed  ModeratorApplication[] @relation("ModeratorApplicationsReviewed")

  @@map("users")
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

// Replaces the old User.googleId column - lets one User hold both a Google
// and an Apple identity (Apple sign-in is App Store-mandated, see
// MOBILE_PLAN.md Phase 0). email is per-provider (Apple private-relay
// addresses differ from User.email) and only informs auto-linking when the
// provider asserts it's verified - AuthService owns that check, not this
// column.
model AuthIdentity {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   AuthProvider
  providerId String
  email      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([provider, providerId])
  @@index([userId])
  @@map("auth_identities")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model ActivityType {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parentId String?
  parent   ActivityType?  @relation("ActivityTypeHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children ActivityType[] @relation("ActivityTypeHierarchy")

  adventurePages   AdventurePage[]
  guideSpecialties GuideSpecialty[]
  activityTracks   ActivityTrack[]

  @@map("activity_types")
}

enum MunicipalityType {
  METROPOLITAN_CITY
  SUB_METROPOLITAN_CITY
  MUNICIPALITY
  RURAL_MUNICIPALITY
}

model Country {
  id        String   @id @default(uuid())
  name      String   @unique
  isoCode   String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provinces Province[]

  @@map("countries")
}

model Province {
  id        String   @id @default(uuid())
  countryId String
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Restrict)
  name      String
  slug      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  districts District[]

  @@unique([countryId, slug])
  @@map("provinces")
}

model District {
  id                       String                                       @id @default(uuid())
  provinceId               String
  province                 Province                                     @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  name                     String
  slug                     String
  requiresRegisteredAgency Boolean                                      @default(false)
  // Nullable: import may be partial, and the ~838 pre-existing location rows
  // predate boundaries. Same Unsupported/GiST/raw-SQL consequences as
  // Trail.geometry - see FEATURE.md §4's district-tagging design.
  boundary                 Unsupported("geometry(MultiPolygon, 4326)")?
  isActive                 Boolean                                      @default(true)
  createdAt                DateTime                                     @default(now())
  updatedAt                DateTime                                     @updatedAt

  municipalities         Municipality[]
  adventurePageDistricts AdventurePageDistrict[]
  guideRegions           GuideRegion[]

  @@unique([provinceId, slug])
  @@map("districts")
}

model Municipality {
  id         String           @id @default(uuid())
  districtId String
  district   District         @relation(fields: [districtId], references: [id], onDelete: Restrict)
  name       String
  slug       String
  type       MunicipalityType
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([districtId, slug])
  @@map("municipalities")
}

model DifficultyLevel {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  adventurePages AdventurePage[]

  @@map("difficulty_levels")
}

model Season {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  adventurePageSeasons AdventurePageSeason[]

  @@map("seasons")
}

enum PageVerificationStatus {
  UNVERIFIED
  VERIFIED
  NEEDS_REVIEW
}

// MILESTONE_3.md §5.1: the approval-pipeline axis. PENDING revisions sit in
// the queue until enough votes (or one admin/moderator vote) land; approving
// one applies its snapshot to the live row and supersedes older pending ones.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalDecision {
  APPROVE
  REJECT
}

model AdventurePage {
  id                   String                 @id @default(uuid())
  title                String
  slug                 String                 @unique
  summary              String?
  activityTypeId       String
  activityType         ActivityType           @relation(fields: [activityTypeId], references: [id], onDelete: Restrict)
  difficultyLevelId    String?
  difficultyLevel      DifficultyLevel?       @relation(fields: [difficultyLevelId], references: [id], onDelete: Restrict)
  durationMinDays      Int?
  durationMaxDays      Int?
  maxAltitudeMeters    Int?
  verificationStatus   PageVerificationStatus @default(UNVERIFIED)
  // MILESTONE_3.md §5.1: null until any revision has ever been approved -
  // the published version. pendingRevisionCount is a cache for the "N
  // unapproved changes" badge (Phase 22 UI), recomputed on every vote.
  approvedRevisionId   String?                @unique
  approvedRevision     PageRevision?          @relation("ApprovedPageRevision", fields: [approvedRevisionId], references: [id], onDelete: SetNull)
  pendingRevisionCount Int                    @default(0)
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  // trigger-maintained (title + summary + latest revision content) - see
  // migration 20260729080000_search_and_notifications. Never written to by
  // Prisma, same "Unsupported columns aren't diff-managed" gotcha as geometry.
  searchVector Unsupported("tsvector")?

  revisions      PageRevision[]
  districts      AdventurePageDistrict[]
  seasons        AdventurePageSeason[]
  media          Media[]
  likes          AdventurePageLike[]
  visits         AdventurePageVisit[]
  trails         Trail[]
  spots          Spot[]
  tripReports    TripReport[]
  tripGroups     TripGroup[]
  activityTracks ActivityTrack[]
  tags           AdventurePageTag[]
  relatedTo      RelatedAdventurePage[]  @relation("PageRelations")
  relatedFrom    RelatedAdventurePage[]  @relation("RelatedByPage")
  views          AdventurePageView[]
  threads        Thread[]

  @@map("adventure_pages")
}

// Append-only view log for the "trending" Discover sort (recent views +
// likes) - deliberately anonymous/unauthenticated (no userId), since public
// page views aren't gated on sign-in. Not deduped by session/IP; a simple
// per-load counter is enough for a non-commercial community site, revisit
// if it ever needs to resist inflation.
model AdventurePageView {
  id              String        @id @default(uuid())
  adventurePageId String
  adventurePage   AdventurePage @relation(fields: [adventurePageId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@index([adventurePageId, createdAt])
  @@map("adventure_page_views")
}

model PageRevision {
  id                   String        @id @default(uuid())
  adventurePageId      String
  adventurePage        AdventurePage @relation(fields: [adventurePageId], references: [id], onDelete: Cascade)
  version              Int
  content              String // Markdown, full snapshot per revision - not a diff
  editSummary          String?
  isSafetyCriticalEdit Boolean       @default(false)
  editorId             String
  editor               User          @relation(fields: [editorId], references: [id], onDelete: Restrict)
  createdAt            DateTime      @default(now())

  // MILESTONE_3.md §5.1: the pending queue. Pre-Phase-21 rows are backfilled
  // to APPROVED by the migration (§5.5) so the live site doesn't flip to
  // "unapproved" on deploy.
  approvalStatus  ApprovalStatus @default(PENDING)
  resolvedAt      DateTime?
  resolvedById    String?
  resolvedBy      User?          @relation("PageRevisionResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  rejectionReason String?
  approvedForPage AdventurePage? @relation("ApprovedPageRevision")

  confirmations PageConfirmation[]

  @@unique([adventurePageId, version])
  @@map("page_revisions")
}

// The vote ballot - CHANGED, not new, per GEODATA_HISTORY.md's precedent of
// retargeting confirmation tables to revisionId. `decision` turns what used
// to be a pure confirm-count into an APPROVE/REJECT vote.
model PageConfirmation {
  id         String           @id @default(uuid())
  revisionId String
  revision   PageRevision     @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  decision   ApprovalDecision @default(APPROVE)
  createdAt  DateTime         @default(now())

  @@unique([revisionId, userId])
  @@map("page_confirmations")
}

enum DistrictTagSource {
  MANUAL // picked by a contributor in the page form
  DERIVED // computed from trail/spot geometry via ST_Intersects/ST_Contains
}

model AdventurePageDistrict {
  id              String            @id @default(uuid())
  adventurePageId String
  adventurePage   AdventurePage     @relation(fields: [adventurePageId], references: [id], onDelete: Cascade)
  districtId      String
  district        District          @relation(fields: [districtId], references: [id], onDelete: Restrict)
  // Was missing createdAt/updatedAt entirely - a standing violation of §2's
  // "every table" convention, fixed in the same migration that adds `source`.
  source          DistrictTagSource @default(MANUAL)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([adventurePageId, districtId])
  @@map("adventure_page_districts")
}

model AdventurePageSeason {
  id              String        @id @default(uuid())
  adventurePageId String
  adventurePage   AdventurePage @relation(fields: [adventurePageId], references: [id], onDelete: Cascade)
  seasonId        String
  season          Season        @relation(fields: [seasonId], references: [id], onDelete: Restrict)

  @@unique([adventurePageId, seasonId])
  @@map("adventure_page_seasons")
}

// Free-form-ish labels beyond ActivityType (curated via the same generic
// master-data CRUD, not fully user-typed, to avoid duplicate/spam tags)
model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages AdventurePageTag[]

  @@map("tags")
}

model AdventurePageTag {
  id              String        @id @default(uuid())
  adventurePageId String
  adventurePage   AdventurePage @relation(fields: [adventurePageId], references: [id], onDelete: Cascade)
  tagId           String
  tag             Tag           @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@unique([adventurePageId, tagId])
  @@map("adventure_page_tags")
}

// "See also" links - symmetric (inserted both directions on create), any
// signed-in contributor can suggest one, same low-friction model as editing
// a page. Revisit if this becomes a spam vector (see TRIP_GROUPS.md-style
// open-decisions framing).
model RelatedAdventurePage {
  id            String        @id @default(uuid())
  pageId        String
  page          AdventurePage @relation("PageRelations", fields: [pageId], references: [id], onDelete: Cascade)
  relatedPageId String
  relatedPage   AdventurePage @relation("RelatedByPage", fields: [relatedPageId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())

  @@unique([pageId, relatedPageId])
  @@map("related_adventure_pages")
}

model Media {
  id              String        @id @default(uuid())
  adventurePageId String
  adventurePage   AdventurePage @relation(fields: [adventurePageId], references: [id], onDelete: Cascade)
  url             String
  // Resized WebP variants from the image-processing pipeline
  // (uploads/image-processor.service.ts). Nullable so uploads made before
  // this pipeline existed keep working - their srcset just falls back to
  // `url` alone. `url` itself continues to point at the "large" variant for
  // anything uploaded through the pipeline, so old callers reading only
  // `url` never see a regression.
  smallUrl        String?
  mediumUrl       String?
  largeUrl        String?
  caption         String?
  altText         String?
  sortOrder       Int           @default(0)
  uploadedById    String
  uploadedBy      User          @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  // MILESTONE_3.md §8: flipped false by an upheld MEDIA report - there's no
  // prior version to fall back to, unlike page/trail/spot content, so this
  // is a plain soft delete rather than a revert.
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())

  @@map("media")
}

model AdventurePageLike {
  id              String        @id @default(uuid())
  adventurePageId String
  adventurePage   AdventurePage @relation(fields: [adventurePageId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([adventurePageId, userId])
  @@map("adventure_page_likes")
}

// Per-user "Been Here" marker - distinct from both Like (opinion) and View
// (anonymous, undeduped) - deduped per user with a timestamp so a future
// trending/"recently most visited" query can use it. See ai/REVISION.md.
model AdventurePageVisit {
  id              String        @id @default(uuid())
  adventurePageId String
  adventurePage   AdventurePage @relation(fields: [adventurePageId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  visitedAt       DateTime      @default(now())

  @@unique([adventurePageId, userId])
  @@index([adventurePageId, visitedAt])
  @@map("adventure_page_visits")
}

enum GeoVerificationStatus {
  UNVERIFIED
  VERIFIED
  NEEDS_REVIEW
}

model SpotType {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  spots         Spot[]
  spotRevisions SpotRevision[]

  @@map("spot_types")
}

// TRAIL_ELEVATION.md - provenance, independent of whether a profile exists
// (a GPX import with no <ele> data still sets GPX_IMPORT but has no profile
// row). RECORDED_ACTIVITY extends this for ACTIVITY_TRACKS.md's promote flow.
enum TrailSource {
  DRAWN
  GPX_IMPORT
  RECORDED_ACTIVITY
}

model Trail {
  id                   String                                    @id @default(uuid())
  adventurePageId      String
  adventurePage        AdventurePage                             @relation(fields: [adventurePageId], references: [id], onDelete: Cascade)
  name                 String?
  geometry             Unsupported("geometry(LineString, 4326)")
  distanceMeters       Int?
  source               TrailSource                               @default(DRAWN)
  verificationStatus   GeoVerificationStatus                     @default(UNVERIFIED)
  approvedRevisionId   String?                                   @unique
  approvedRevision     TrailRevision?                            @relation("ApprovedTrail", fields: [approvedRevisionId], references: [id], onDelete: SetNull)
  pendingRevisionCount Int                                       @default(0)
  isActive             Boolean                                   @default(true)
  createdById          String
  createdBy            User                                      @relation("TrailCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lastEditedById       String
  lastEditedBy         User                                      @relation("TrailLastEditedBy", fields: [lastEditedById], references: [id], onDelete: Restrict)
  createdAt            DateTime                                  @default(now())
  updatedAt            DateTime                                  @updatedAt

  revisions        TrailRevision[]
  elevationProfile TrailElevationProfile?
  threads          Thread[]

  @@map("trails")
}

// Sidecar, not LineStringZ - see TRAIL_ELEVATION.md's "Core design decision".
// samples is a whole-object read (chart data), never queried into, so Json
// beats a normalized samples table.
model TrailElevationProfile {
  id                 String   @id @default(uuid())
  trailId            String   @unique
  trail              Trail    @relation(fields: [trailId], references: [id], onDelete: Cascade)
  samples            Json
  sampleCount        Int
  ascentMeters       Int
  descentMeters      Int
  minElevationMeters Int
  maxElevationMeters Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("trail_elevation_profiles")
}

// CHANGED, not new - retargeted from trailId to revisionId, arriving at
// exactly PageConfirmation's shape (@@unique([revisionId, userId]), no
// trailId-equivalent on this table either). See GEODATA_HISTORY.md.
model TrailConfirmation {
  id         String           @id @default(uuid())
  revisionId String
  revision   TrailRevision    @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  decision   ApprovalDecision @default(APPROVE)
  createdAt  DateTime         @default(now())

  @@unique([revisionId, userId])
  @@map("trail_confirmations")
}

// Full snapshot per edit, mirrors PageRevision.content - see GEODATA_HISTORY.md.
model TrailRevision {
  id                   String                                    @id @default(uuid())
  trailId              String
  trail                Trail                                     @relation(fields: [trailId], references: [id], onDelete: Cascade)
  version              Int
  geometry             Unsupported("geometry(LineString, 4326)")
  name                 String?
  distanceMeters       Int?
  editSummary          String?
  isSafetyCriticalEdit Boolean                                   @default(false)
  editorId             String
  editor               User                                      @relation("TrailRevisionEditor", fields: [editorId], references: [id], onDelete: Restrict)
  createdAt            DateTime                                  @default(now())

  // MILESTONE_3.md §5.1 - see PageRevision's identical block for the full note.
  approvalStatus   ApprovalStatus @default(PENDING)
  resolvedAt       DateTime?
  resolvedById     String?
  resolvedBy       User?          @relation("TrailRevisionResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  rejectionReason  String?
  approvedForTrail Trail?         @relation("ApprovedTrail")

  confirmations TrailConfirmation[]

  @@unique([trailId, version])
  @@map("trail_revisions")
}

model Spot {
  id                   String                               @id @default(uuid())
  adventurePageId      String
  adventurePage        AdventurePage                        @relation(fields: [adventurePageId], references: [id], onDelete: Cascade)
  spotTypeId           String
  spotType             SpotType                             @relation(fields: [spotTypeId], references: [id], onDelete: Restrict)
  name                 String
  description          String?
  geometry             Unsupported("geometry(Point, 4326)")
  elevationMeters      Int?
  verificationStatus   GeoVerificationStatus                @default(UNVERIFIED)
  approvedRevisionId   String?                              @unique
  approvedRevision     SpotRevision?                        @relation("ApprovedSpot", fields: [approvedRevisionId], references: [id], onDelete: SetNull)
  pendingRevisionCount Int                                  @default(0)
  isActive             Boolean                              @default(true)
  createdById          String
  createdBy            User                                 @relation("SpotCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lastEditedById       String
  lastEditedBy         User                                 @relation("SpotLastEditedBy", fields: [lastEditedById], references: [id], onDelete: Restrict)
  createdAt            DateTime                             @default(now())
  updatedAt            DateTime                             @updatedAt

  revisions SpotRevision[]
  threads   Thread[]

  @@map("spots")
}

// CHANGED, not new - retargeted from spotId to revisionId. See GEODATA_HISTORY.md.
model SpotConfirmation {
  id         String           @id @default(uuid())
  revisionId String
  revision   SpotRevision     @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  decision   ApprovalDecision @default(APPROVE)
  createdAt  DateTime         @default(now())

  @@unique([revisionId, userId])
  @@map("spot_confirmations")
}

// Full snapshot per edit, mirrors PageRevision.content - see GEODATA_HISTORY.md.
model SpotRevision {
  id                   String                               @id @default(uuid())
  spotId               String
  spot                 Spot                                 @relation(fields: [spotId], references: [id], onDelete: Cascade)
  version              Int
  geometry             Unsupported("geometry(Point, 4326)")
  spotTypeId           String
  spotType             SpotType                             @relation(fields: [spotTypeId], references: [id], onDelete: Restrict)
  name                 String
  description          String?
  elevationMeters      Int?
  editSummary          String?
  isSafetyCriticalEdit Boolean                              @default(false)
  editorId             String
  editor               User                                 @relation("SpotRevisionEditor", fields: [editorId], references: [id], onDelete: Restrict)
  createdAt            DateTime                             @default(now())

  // MILESTONE_3.md §5.1 - see PageRevision's identical block for the full note.
  approvalStatus  ApprovalStatus @default(PENDING)
  resolvedAt      DateTime?
  resolvedById    String?
  resolvedBy      User?          @relation("SpotRevisionResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  rejectionReason String?
  approvedForSpot Spot?          @relation("ApprovedSpot")

  confirmations SpotConfirmation[]

  @@unique([spotId, version])
  @@map("spot_revisions")
}

model TripReport {
  id               String        @id @default(uuid())
  adventurePageId  String
  adventurePage    AdventurePage @relation(fields: [adventurePageId], references: [id], onDelete: Cascade)
  authorId         String
  author           User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  title            String?
  description      String? // short summary shown in list views
  content          String? // full story, markdown - rendered like AdventurePage content
  dateCompleted    DateTime
  durationDays     Int?
  actualCostAmount Int?
  currency         String        @default("NPR") // fixed short list (NPR/USD/EUR/INR), validated in the DTO
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  media          TripReportMedia[]
  kudos          TripReportKudos[]
  comments       Comment[]
  activityTracks ActivityTrack[]

  // Nullable, SetNull not Cascade - same rationale as ActivityTrack's page/
  // report FKs below: a club is a tag on a personal record, so deactivating
  // it must not touch the record itself. The author picks this at authoring
  // time from clubs they belong to (checked in the service, not the DTO).
  clubId String?
  club   Club?   @relation(fields: [clubId], references: [id], onDelete: SetNull)

  threads Thread[]

  @@map("trip_reports")
}

// ACTIVITY_TRACKS.md - user-owned, private-by-default recording. Deliberately
// a separate table from Trail, not a nullable Trail.userId - see the doc's
// "Core design decision" for why (ownership/mutability/trust/timestamps/
// visibility all diverge from Trail simultaneously).
enum ActivityTrackVisibility {
  PRIVATE
  PUBLIC
}

enum ActivityTrackSource {
  RECORDED
  IMPORTED
}

model ActivityTrack {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Nullable, unlike TripReport.adventurePageId - recording an unlisted route
  // is the case that grows the map. SetNull, not Cascade: deleting a page
  // must not destroy someone's personal record of their own hike.
  adventurePageId String?
  adventurePage   AdventurePage? @relation(fields: [adventurePageId], references: [id], onDelete: SetNull)
  // Many tracks per report - a multi-day trek is one track per day, one story.
  tripReportId    String?
  tripReport      TripReport?    @relation(fields: [tripReportId], references: [id], onDelete: SetNull)

  activityTypeId String
  activityType   ActivityType @relation(fields: [activityTypeId], references: [id], onDelete: Restrict)
  name           String?
  notes          String?

  // Simplified path, for map rendering and spatial queries only. Full-fidelity
  // series lives in `samples` - the same sidecar split TrailElevationProfile
  // uses, for the same reason: geometry(LineString, 4326) forbids Z and M.
  geometry    Unsupported("geometry(LineString, 4326)")
  // [{ t: <s from startedAt>, d: <m along path>, e: <m elevation> }, ...]
  // Whole-object read, never queried into. Timestamps are legitimate here -
  // this row is user-owned and private by default, unlike a public Trail.
  samples     Json
  sampleCount Int

  startedAt          DateTime
  finishedAt         DateTime
  elapsedSeconds     Int
  movingSeconds      Int?
  distanceMeters     Int
  ascentMeters       Int?
  descentMeters      Int?
  minElevationMeters Int?
  maxElevationMeters Int?

  source            ActivityTrackSource
  visibility        ActivityTrackVisibility @default(PRIVATE)
  privacyTrimMeters Int? // metres trimmed from each end for non-owners
  // Client-generated, so an offline upload retry is idempotent instead of
  // duplicating the track. Nullable; Postgres treats two NULLs as unequal,
  // so the composite unique still permits many server-created rows.
  clientUuid        String?
  originalFileUrl   String? // uploaded GPX/KML retained for re-parsing

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, clientUuid])
  @@index([userId, startedAt])
  @@map("activity_tracks")
}

model TripReportMedia {
  id           String     @id @default(uuid())
  tripReportId String
  tripReport   TripReport @relation(fields: [tripReportId], references: [id], onDelete: Cascade)
  url          String
  // See Media's identical fields for why these are nullable.
  smallUrl     String?
  mediumUrl    String?
  largeUrl     String?
  caption      String?
  altText      String?
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  @@map("trip_report_media")
}

model TripReportKudos {
  id           String     @id @default(uuid())
  tripReportId String
  tripReport   TripReport @relation(fields: [tripReportId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([tripReportId, userId])
  @@map("trip_report_kudos")
}

model Comment {
  id           String     @id @default(uuid())
  tripReportId String
  tripReport   TripReport @relation(fields: [tripReportId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  content      String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  parentCommentId String?
  parentComment   Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[] @relation("CommentReplies")

  @@map("comments")
}

// Trip-companion groups (IDEA.md's Strava-clubs pillar): a shared route +
// date window to find companions for. Deliberately no messaging model here -
// IDEA.md keeps contact informational-only, this is membership metadata,
// not chat.
enum TripGroupRole {
  ORGANIZER
  MEMBER
}

// The organizer-managed lifecycle, distinct from isActive (which stays a
// pure admin-moderation soft-delete flag). UPCOMING/ONGOING/EXPIRED are
// deliberately not values here - they're derived from dateStart/dateEnd at
// read time (see TripGroupsService), never stored, so they can't drift out
// of sync with "now". ACTIVE is the only state that badge applies to.
enum TripGroupStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model TripGroup {
  id              String          @id @default(uuid())
  adventurePageId String
  adventurePage   AdventurePage   @relation(fields: [adventurePageId], references: [id], onDelete: Cascade)
  title           String
  description     String // Markdown, rendered like TripReport.content
  dateStart       DateTime
  dateEnd         DateTime
  createdById     String
  createdBy       User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  status          TripGroupStatus @default(ACTIVE)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  members TripGroupMember[]

  @@map("trip_groups")
}

model TripGroupMember {
  id          String        @id @default(uuid())
  tripGroupId String
  tripGroup   TripGroup     @relation(fields: [tripGroupId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        TripGroupRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  @@unique([tripGroupId, userId])
  @@map("trip_group_members")
}

enum ClubVisibility {
  PUBLIC
  PRIVATE
}

// MODERATOR is club-scoped, promoted by the OWNER (or a site ADMIN/
// MODERATOR) from an existing MEMBER - distinct from the site-wide
// Role.MODERATOR, the same way GuideVerificationStatus is distinct from
// PageVerificationStatus despite the similar name.
enum ClubRole {
  OWNER
  MODERATOR
  MEMBER
}

// PENDING doubles as a private club's join request - there's no separate
// request table, since a request and a membership are the same relationship
// at different lifecycle stages (unlike ModeratorApplication, which is
// genuinely distinct from the User.role it eventually sets). BANNED blocks
// both join() and requestToJoin() the same way any other existing row does,
// so no extra guard was needed there - see clubs.service.ts.
enum ClubMembershipStatus {
  PENDING
  APPROVED
  DECLINED
  BANNED
}

// Freestanding persistent community, distinct from TripGroup - no
// AdventurePage FK, no per-trip date window. Any logged-in user can create
// one and becomes its OWNER. Deliberately no ContributionEvent involvement
// anywhere in this model.
model Club {
  id            String         @id @default(uuid())
  name          String
  description   String?
  coverImageUrl String?
  visibility    ClubVisibility @default(PUBLIC)
  createdById   String
  createdBy     User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  members     ClubMember[]
  tripReports TripReport[]
  threads     Thread[]

  @@map("clubs")
}

model ClubMember {
  id       String               @id @default(uuid())
  clubId   String
  club     Club                 @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId   String
  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     ClubRole             @default(MEMBER)
  status   ClubMembershipStatus @default(APPROVED)
  joinedAt DateTime             @default(now())

  // Set when a PENDING request is approved/declined by the club owner or a
  // site ADMIN/MODERATOR - blank for open-join PUBLIC-club rows, which are
  // never PENDING in the first place.
  decidedById String?
  decidedBy   User?     @relation("ClubMembershipDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?

  @@unique([clubId, userId])
  @@map("club_members")
}

enum ThreadTag {
  DISCUSSION
  TRIP_SHARE
  QUESTION
  ANNOUNCEMENT
  RANDOM
}

// A club's feed unit - a discussion post, not a factual claim, so no
// verification tier and never approval-gated, same reasoning as TripReport.
// Each of the four attachment FKs is independently optional and SetNull:
// a thread is a discussion *about* content, not a container for it, so
// deactivating/deleting the attached item must not destroy the thread.
model Thread {
  id        String    @id @default(uuid())
  clubId    String
  club      Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  content   String
  tag       ThreadTag @default(DISCUSSION)
  isActive  Boolean   @default(true)
  // Pin/lock is a moderation action, not author-settable - enforced in the
  // service layer, same split as ClubMember.role vs status.
  isPinned  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tripReportId    String?
  tripReport      TripReport?    @relation(fields: [tripReportId], references: [id], onDelete: SetNull)
  trailId         String?
  trail           Trail?         @relation(fields: [trailId], references: [id], onDelete: SetNull)
  spotId          String?
  spot            Spot?          @relation(fields: [spotId], references: [id], onDelete: SetNull)
  adventurePageId String?
  adventurePage   AdventurePage? @relation(fields: [adventurePageId], references: [id], onDelete: SetNull)

  replies ThreadReply[]

  @@index([clubId, isActive, createdAt])
  @@map("threads")
}

// Mirrors Comment's shape (one level of self-referential nesting) rather
// than a nullable threadId on Comment itself - see CLAUDE.md's stated
// preference for a duplicated-but-simple table over a polymorphic one.
model ThreadReply {
  id        String   @id @default(uuid())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentReplyId String?
  parentReply   ThreadReply?  @relation("ThreadReplyReplies", fields: [parentReplyId], references: [id], onDelete: Cascade)
  replies       ThreadReply[] @relation("ThreadReplyReplies")

  @@map("thread_replies")
}

enum GuideVerificationStatus {
  UNVERIFIED
  PENDING_LICENSE_REVIEW
  VERIFIED
}

model Language {
  id        String   @id @default(uuid())
  name      String   @unique
  isoCode   String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guideLanguages GuideLanguage[]

  @@map("languages")
}

enum RateUnit {
  PER_DAY
  PER_TRIP
  PER_HOUR
}

model GuideProfile {
  id                 String                  @id @default(uuid())
  userId             String                  @unique
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber      String?
  bio                String?
  rateMin            Int?
  rateMax            Int?
  rateUnit           RateUnit?
  // I18N.md: was missing entirely - GuideProfile had rateMin/rateMax/
  // rateUnit but no currency column, so NPR was hardcoded at four UI sites
  // while TripReport.currency has existed since Phase 13. Same shape as
  // that column: a fixed short list validated in the DTO, not a Prisma enum.
  currency           String                  @default("NPR")
  verificationStatus GuideVerificationStatus @default(UNVERIFIED)
  isActive           Boolean                 @default(true)
  // MILESTONE_3.md §2.2: GuideProfile becomes universal (one row per user,
  // auto-created on first login), so the public /guides directory now
  // filters on this rather than listing every row.
  isListed           Boolean                 @default(false)
  // Denormalized caches over ContributionEvent / approval votes - the
  // ledger is the source of truth; a recompute command exists for drift.
  contributionPoints Int                     @default(0)
  guideLevel         Int                     @default(1)
  approvalsGiven     Int                     @default(0)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  specialties GuideSpecialty[]
  regions     GuideRegion[]
  languages   GuideLanguage[]

  @@map("guide_profiles")
}

model GuideSpecialty {
  id             String       @id @default(uuid())
  guideProfileId String
  guideProfile   GuideProfile @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  activityTypeId String
  activityType   ActivityType @relation(fields: [activityTypeId], references: [id], onDelete: Restrict)

  @@unique([guideProfileId, activityTypeId])
  @@map("guide_specialties")
}

model GuideRegion {
  id             String       @id @default(uuid())
  guideProfileId String
  guideProfile   GuideProfile @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  districtId     String
  district       District     @relation(fields: [districtId], references: [id], onDelete: Restrict)

  @@unique([guideProfileId, districtId])
  @@map("guide_regions")
}

model GuideLanguage {
  id             String       @id @default(uuid())
  guideProfileId String
  guideProfile   GuideProfile @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  languageId     String
  language       Language     @relation(fields: [languageId], references: [id], onDelete: Restrict)

  @@unique([guideProfileId, languageId])
  @@map("guide_languages")
}

enum NotificationType {
  COMMENT
  REPLY
  KUDOS
  PAGE_VERIFIED
  TRAIL_VERIFIED
  SPOT_VERIFIED
  GUIDE_VERIFIED
  // MILESTONE_3.md §8/§9.4: report resolution is in Phase 23's scope even
  // though the full notification-type sweep is Phase 25's job - "editor and
  // reporter both notified" is a stated Phase 23 requirement.
  REPORT_RESOLVED
  REPORT_UPHELD_AGAINST_YOU
  // §7: "Approval sets user.role = MODERATOR ... and notifies" - pulled
  // forward into Phase 24 for the same reason Phase 23 pulled forward the
  // two REPORT_* types above: it's a stated requirement of the phase that
  // actually builds the feature, not the later i18n/notification sweep.
  MODERATOR_APPLICATION_DECIDED
  // MILESTONE_3.md §9.4, completing the sweep in Phase 25.
  CHANGE_APPROVED
  CHANGE_REJECTED
  LEVEL_UP
  // CLUB_PLAN.md: a private club's owner is notified of a new join request,
  // and the requester is notified once it's approved/declined.
  CLUB_JOIN_REQUESTED
  CLUB_JOIN_DECIDED
  // A reply on a thread notifies the parent reply's author, or the thread
  // author for a top-level reply - same branch as REPLY on Comment.
  THREAD_REPLY
}

// one-way system messages, not user chat - doesn't reopen IDEA.md's
// no-in-app-messaging ruling, per TRIP_GROUPS.md-style framing
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  linkUrl   String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

enum DevicePlatform {
  IOS
  ANDROID
}

// Phase 6: an Expo push token is per-install, not per-account - unique on
// token (re-registering under a different signed-in user re-parents it),
// hard-deleted on unregister or an Expo DeviceNotRegistered receipt rather
// than soft-deleted, since a stale token has no reason to stick around.
model DeviceToken {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String         @unique
  platform  DevicePlatform
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
  @@map("device_tokens")
}

// Phase 6: one row per user, four flat booleans rather than a category join
// table - the category set is small and fixed (see notification-category.ts
// for the NotificationType -> category grouping), not open-ended.
model NotificationPreference {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialEnabled        Boolean  @default(true)
  contributionsEnabled Boolean  @default(true)
  moderationEnabled    Boolean  @default(true)
  clubsEnabled         Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("notification_preferences")
}

// MILESTONE_3.md §6: runtime-tunable economy/threshold values (approval
// threshold, minimum guide levels, point values) so the contribution
// economy doesn't require a deploy to adjust. Read through a cached
// SettingsService, admin-only write, every write logged with updatedById.
model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

// MILESTONE_3.md §3.1: append-only contribution ledger. Points are awarded
// only on the write paths listed below (all pre-approval-gate for now -
// the gate itself arrives in Phase 21, see §5); this table is the source
// of truth, GuideProfile.contributionPoints/guideLevel are caches over it.
enum ContributionReason {
  PAGE_CREATE // +10
  PAGE_UPDATE // +20 (only when editing someone else's page)
  GEO_CREATE // +20 (trail or spot added to an activity)
  GEO_UPDATE // +25 (only when editing someone else's trail/spot)
  MEDIA_UPLOAD // +2 per image
  STORY_CREATE // +5 (trip report; no approval gate)
  MEDIA_REPORT_UPHELD // -3
  GEO_REPORT_UPHELD // -30
  PAGE_REPORT_UPHELD // reverses the original award (-10 / -20)
  BACKFILL // one-off replay of pre-Milestone-3 history
  ADMIN_ADJUSTMENT // manual correction, requires a note
}

enum ContributionTargetType {
  ADVENTURE_PAGE
  PAGE_REVISION
  TRAIL
  TRAIL_REVISION
  SPOT
  SPOT_REVISION
  MEDIA
  TRIP_REPORT
}

// targetId deliberately carries no FK - see MILESTONE_3.md §3.1: eight
// duplicated ledger tables would be absurd, and this is an append-only
// audit log never joined for referential integrity. Reads resolve the
// target lazily and tolerate a missing row (content can be hard-deleted).
model ContributionEvent {
  id         String                 @id @default(uuid())
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason     ContributionReason
  points     Int // signed
  targetType ContributionTargetType
  targetId   String
  note       String?
  createdAt  DateTime               @default(now())

  // anti-double-award guard: approving a revision twice, or a retried
  // transaction, cannot pay twice.
  @@unique([userId, reason, targetId])
  @@index([userId, createdAt])
  @@map("contribution_events")
}

// MILESTONE_3.md §8: one flat table for every reportable content type
// (targetId deliberately carries no FK, same audit-log exception the
// ContributionEvent doc comment explains - a report can outlive its target
// if an admin hard-deletes something separately).
enum ReportTargetType {
  ADVENTURE_PAGE
  PAGE_REVISION
  TRAIL
  TRAIL_REVISION
  SPOT
  SPOT_REVISION
  MEDIA
  TRIP_REPORT
  COMMENT
  THREAD
  THREAD_REPLY
}

enum ReportReason {
  FAKE_OR_FALSE
  INAPPROPRIATE
  COPYRIGHT
  DUPLICATE
  SAFETY_RISK
  OTHER
}

enum ReportStatus {
  PENDING
  UPHELD
  REJECTED
}

model ContentReport {
  id             String           @id @default(uuid())
  reporterId     String
  reporter       User             @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType     ReportTargetType
  targetId       String
  reason         ReportReason
  details        String?
  status         ReportStatus     @default(PENDING)
  resolvedById   String?
  resolvedBy     User?            @relation("ReportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("content_reports")
}

// MILESTONE_3.md §7: promotion queue for Role.MODERATOR. Submitting
// requires guideLevel >= moderator.minGuideLevel and no existing PENDING
// application (enforced in the service, not the schema); only ADMIN
// reviews, and approval flips user.role in the same transaction.
enum ModeratorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model ModeratorApplication {
  id           String                     @id @default(uuid())
  userId       String
  user         User                       @relation("ModeratorApplicationsSubmitted", fields: [userId], references: [id], onDelete: Cascade)
  statement    String
  status       ModeratorApplicationStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?                      @relation("ModeratorApplicationsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@index([status])
  @@map("moderator_applications")
}
