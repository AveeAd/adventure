{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "seed:locations": "tsx prisma/scripts/import-locations.ts",
    "seed:district-boundaries": "tsx prisma/scripts/import-district-boundaries.ts",
    "seed:master-data": "tsx prisma/scripts/seed-master-data.ts",
    "seed:system-settings": "tsx prisma/scripts/seed-system-settings.ts",
    "seed:dev-data": "tsx prisma/scripts/seed-dev-data.ts",
    "backfill:contributions": "tsx prisma/scripts/backfill-contributions.ts",
    "seed:all": "npm run seed:locations && npm run seed:district-boundaries && npm run seed:master-data && npm run seed:system-settings && npm run seed:dev-data && npm run backfill:contributions"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "@types/adm-zip": "^0.5.8",
    "@types/diff": "^7.0.2",
    "adm-zip": "^0.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "diff": "^9.0.0",
    "fast-xml-parser": "^5.10.1",
    "ms": "^2.1.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/ms": "^0.7.34",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
