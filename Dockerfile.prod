# syntax=docker/dockerfile:1
#
# Production multi-stage build for all three apps, shared across one pnpm
# workspace install (mirrors the monorepo layout Dockerfile.dev uses for
# dev). Unlike Dockerfile.dev, this compiles each app and ships only the
# built output + production deps - no bind mounts, no watch mode.

# ---- build: compile api/admin/public from one shared install ----
FROM node:22-bookworm-slim AS build
RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate

# Baked into the admin/public client bundles at build time (Vite env vars
# aren't runtime-configurable) - browsers call this URL directly, so it must
# be the real public API domain, not a docker-network address. See
# apps/public/src/lib/auth/api.ts's SERVER_API_URL/CLIENT_API_URL split for
# why the server-side fetch path doesn't need this.
ARG VITE_API_URL
# Baked into the public client bundle only (admin is never indexed) - the
# canonical/OG URL base used by apps/public/src/lib/seo.ts.
ARG VITE_SITE_URL

# Copy only the package manifests first (pnpm's workspace install needs
# every workspace's package.json to resolve the install, but none of their
# source) so this layer - the slow one - stays cached across deploys where
# dependencies haven't changed, instead of re-resolving from scratch on
# every commit. COPY . . below still invalidates on any file change, but by
# then pnpm install has already run. packages/api-types is included even
# though only apps/mobile depends on it, because pnpm's workspace install
# resolves the whole pnpm-workspace.yaml glob and --frozen-lockfile fails if
# any workspace member referenced in the lockfile is missing on disk.
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/api/package.json ./apps/api/package.json
COPY apps/admin/package.json ./apps/admin/package.json
COPY apps/public/package.json ./apps/public/package.json
COPY packages/api-types/package.json ./packages/api-types/package.json
# apps/api's postinstall runs `prisma generate`, which needs the schema
# present at install time - not just source, so it has to come before
# pnpm install too, even though it isn't a package manifest.
COPY apps/api/prisma ./apps/api/prisma
RUN pnpm install --frozen-lockfile

COPY . .

RUN pnpm --filter api build
RUN VITE_API_URL=${VITE_API_URL} pnpm --filter admin build
RUN VITE_API_URL=${VITE_API_URL} VITE_SITE_URL=${VITE_SITE_URL} pnpm --filter public build

# Prune each deployed app to a standalone, isolated node_modules - only what
# that app actually needs, not the other two apps' dependency trees.
# --legacy is required: pnpm 10's non-legacy deploy path only supports
# workspaces with inject-workspace-packages=true, which this repo doesn't
# use. api is deployed WITHOUT --prod because its container CMD runs
# `prisma migrate deploy` at startup, which needs the `prisma` CLI - a
# devDependency - present at runtime (mirrors the old npm image, which
# shipped devDependencies too since `npm ci` installs them by default).
# public is pure runtime with no CLI tooling needed, so --prod keeps it lean.
#
# pnpm deploy's own postinstall run of `prisma generate` does not reliably
# produce a working `.prisma/client` inside the deployed directory (verified
# empirically - the generated client dir ends up missing even though the
# postinstall log reports success), so it's re-run explicitly against the
# deployed output as a fix-up step.
RUN pnpm --filter=api deploy --legacy /out/api \
  && cd /out/api && node_modules/.bin/prisma generate --schema=prisma/schema.prisma
RUN pnpm --filter=public deploy --prod --legacy /out/public

# ---- api: compiled Nest app + production node_modules ----
FROM node:22-bookworm-slim AS api
RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app/apps/api
COPY --from=build /out/api/node_modules ./node_modules
COPY --from=build /app/apps/api/dist ./dist
COPY --from=build /app/apps/api/prisma ./prisma
COPY --from=build /app/apps/api/package.json ./package.json
ENV NODE_ENV=production
EXPOSE 3000
CMD ["sh", "-c", "npx prisma migrate deploy --schema=prisma/schema.prisma && node dist/main"]

# ---- admin: static SPA served by nginx ----
FROM nginx:1.27-alpine AS admin
COPY --from=build /app/apps/admin/dist /usr/share/nginx/html
COPY apps/admin/nginx.conf /etc/nginx/conf.d/default.conf

# ---- public: TanStack Start SSR, run via the hand-written Node adapter in
# server.prod.mjs (the framework's Vite build only emits a fetch handler,
# not a listener or static-file server - see that file's header comment).
# dist/server/server.js externalizes react/react-dom rather than bundling
# them (standard SSR practice, avoids duplicate-instance issues), so - same
# as the api stage - this needs real node_modules, not just the dist output.
FROM node:22-bookworm-slim AS public
WORKDIR /app/apps/public
COPY --from=build /out/public/node_modules ./node_modules
COPY --from=build /app/apps/public/dist ./dist
COPY apps/public/server.prod.mjs ./server.prod.mjs
ENV NODE_ENV=production
ENV PORT=3001
EXPOSE 3001
CMD ["node", "server.prod.mjs"]
