# syntax=docker/dockerfile:1
#
# Production multi-stage build for all three apps, shared across one npm
# workspace install (mirrors the monorepo layout Dockerfile.dev uses for
# dev). Unlike Dockerfile.dev, this compiles each app and ships only the
# built output + production deps - no bind mounts, no watch mode.

# ---- build: compile api/admin/public from one shared install ----
FROM node:22-bookworm-slim AS build
RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# Baked into the admin/public client bundles at build time (Vite env vars
# aren't runtime-configurable) - browsers call this URL directly, so it must
# be the real public API domain, not a docker-network address. See
# apps/public/src/lib/auth/api.ts's SERVER_API_URL/CLIENT_API_URL split for
# why the server-side fetch path doesn't need this.
ARG VITE_API_URL
# Baked into the public client bundle only (admin is never indexed) - the
# canonical/OG URL base used by apps/public/src/lib/seo.ts.
ARG VITE_SITE_URL

# Copy only the package manifests first (npm workspaces needs every
# workspace's package.json to resolve the install, but none of their source)
# so this layer - the slow one - stays cached across deploys where
# dependencies haven't changed, instead of re-running npm ci from scratch on
# every commit. COPY . . below still invalidates on any file change, but by
# then npm ci has already run.
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY apps/admin/package.json ./apps/admin/package.json
COPY apps/public/package.json ./apps/public/package.json
# apps/api's postinstall runs `prisma generate`, which needs the schema
# present at install time - not just source, so it has to come before npm ci
# too, even though it isn't a package manifest.
COPY apps/api/prisma ./apps/api/prisma
RUN npm ci

COPY . .

RUN npm run build --workspace=apps/api
RUN VITE_API_URL=${VITE_API_URL} npm run build --workspace=apps/admin
RUN VITE_API_URL=${VITE_API_URL} VITE_SITE_URL=${VITE_SITE_URL} npm run build --workspace=apps/public

# ---- api: compiled Nest app + production node_modules ----
FROM node:22-bookworm-slim AS api
RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/api/prisma ./apps/api/prisma
COPY --from=build /app/apps/api/package.json ./apps/api/package.json
WORKDIR /app/apps/api
ENV NODE_ENV=production
EXPOSE 3000
CMD ["sh", "-c", "npx prisma migrate deploy --schema=prisma/schema.prisma && node dist/main"]

# ---- admin: static SPA served by nginx ----
FROM nginx:1.27-alpine AS admin
COPY --from=build /app/apps/admin/dist /usr/share/nginx/html
COPY apps/admin/nginx.conf /etc/nginx/conf.d/default.conf

# ---- public: TanStack Start SSR, run via the hand-written Node adapter in
# server.prod.mjs (the framework's Vite build only emits a fetch handler,
# not a listener or static-file server - see that file's header comment).
# dist/server/server.js externalizes react/react-dom rather than bundling
# them (standard SSR practice, avoids duplicate-instance issues), so - same
# as the api stage - this needs real node_modules, not just the dist output.
FROM node:22-bookworm-slim AS public
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/public/node_modules ./apps/public/node_modules
COPY --from=build /app/apps/public/dist ./apps/public/dist
COPY apps/public/server.prod.mjs ./apps/public/server.prod.mjs
WORKDIR /app/apps/public
ENV NODE_ENV=production
ENV PORT=3001
EXPOSE 3001
CMD ["node", "server.prod.mjs"]
